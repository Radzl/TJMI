# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Regresión visual: las referencias se versionan, lo demás no.
tests/visual/salida/

# Rendimiento: el resumen se versiona, los informes en crudo no.
# Son 1,8 MB que cambian en cada pasada y se regeneran con el comando que
# documenta tests/perf/linea-base.md. Misma regla que tests/visual/salida.
tests/perf/informes/
